PORT=3000
# Bỏ trống hoặc * = cho mọi origin (tiện khi mở frontend bằng IP LAN trên điện thoại).
# Hoặc danh sách cách nhau bởi dấu phẩy: http://localhost:4200,http://192.168.1.5:4200
# FRONTEND_ORIGIN=http://localhost:4200
# FRONTEND_ORIGINS=http://localhost:4200,http://192.168.1.5:4200
# Lắng nghe mọi interface (mặc định 0.0.0.0) để điện thoại trong LAN gọi được.
# HOST=0.0.0.0

OPENROUTER_KEY=your_openrouter_key
# Model tra phi (vd. openai/gpt-4o-mini) on dinh hon. Slug :free / openrouter/free de bi 429 "free-models-per-day".
OPENROUTER_MODEL=openai/gpt-4o-mini
# Thu model thu 2 khi model chinh 429 (tuy chon).
OPENROUTER_FALLBACK_MODEL=
# OPENROUTER_TIMEOUT_MS=60000
# OPENROUTER_HTTP_REFERER=http://localhost:4200
# OPENROUTER_APP_TITLE=AI Astrology Avatar

AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_VOICE=vi-VN-HoaiMyNeural

# ZipVoice TTS (POST /tts, x-www-form-urlencoded). Nếu set ZIPVOICE_TTS_URL thì ưu tiên trước Azure.
# ZIPVOICE_TTS_URL=https://unoverlooked-soulfully-rayna.ngrok-free.dev
# ZIPVOICE_VOICE=ref5
# ZIPVOICE_NUM_STEP=16
# ZIPVOICE_FIRST_CHUNK_WORDS=10
# ZIPVOICE_MIN_CHUNK_WORDS=15
# ZIPVOICE_BATCH_SIZE=2
# ZIPVOICE_NO_WARMUP=true
# ZIPVOICE_TTS_TIMEOUT_MS=180000
